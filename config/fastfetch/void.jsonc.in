// VOID — fastfetch. Generated from config/tokens.toml by `bin/void tokens build` — do not edit by hand.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@LOGO@",
    "color": {
      "1": "38;2;242;242;242",
      "2": "38;2;119;119;119",
      "3": "38;2;51;51;51"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ▸ ",
    "disableLinewrap": true,
    "color": {
      "keys": "38;2;119;119;119",
      "title": "38;2;242;242;242",
      "output": "38;2;229;229;229",
      "separator": "38;2;51;51;51"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "OS       "
    },
    {
      "type": "kernel",
      "key": "KERNEL   "
    },
    {
      "type": "uptime",
      "key": "UPTIME   "
    },
    {
      "type": "de",
      "key": "PLASMA   "
    },
    {
      "type": "wm",
      "key": "KWIN     "
    },
    {
      "type": "cpu",
      "key": "CPU      "
    },
    {
      "type": "gpu",
      "key": "GPU      "
    },
    {
      "type": "memory",
      "key": "RAM      "
    },
    {
      "type": "disk",
      "key": "STORAGE  ",
      "folders": "/"
    },
    {
      "type": "terminal",
      "key": "TERMINAL "
    },
    {
      "type": "display",
      "key": "DISPLAY  "
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0
    }
  ]
}
