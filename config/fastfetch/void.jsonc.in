// VOID — fastfetch. Generated from config/tokens.toml by `bin/void tokens build` — do not edit by hand.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@LOGO@",
    "color": {
      "1": "38;2;242;242;242",
      "2": "38;2;119;119;119",
      "3": "38;2;51;51;51"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "disableLinewrap": true,
    "color": {
      "keys": "38;2;119;119;119",
      "title": "38;2;242;242;242",
      "output": "38;2;229;229;229",
      "separator": "38;2;51;51;51"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "┌────── Hardware Information ──────┐",
      "outputColor": "38;2;170;170;170"
    },
    {
      "type": "host",
      "key": "  ▪ host    ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "cpu",
      "key": "  ▪ cpu     ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "gpu",
      "key": "  ▪ gpu     ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "memory",
      "key": "  ▪ ram     ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "disk",
      "key": "  ▪ storage ",
      "keyColor": "38;2;119;119;119",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "  ▪ display ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "custom",
      "format": "┌────── Software Information ──────┐",
      "outputColor": "38;2;170;170;170"
    },
    {
      "type": "os",
      "key": "  ▪ os      ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "kernel",
      "key": "  ▪ kernel  ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "de",
      "key": "  ▪ plasma  ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "wm",
      "key": "  ▪ kwin    ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "shell",
      "key": "  ▪ shell   ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "terminal",
      "key": "  ▪ terminal",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "packages",
      "key": "  ▪ packages",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "uptime",
      "key": "  ▪ uptime  ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "localip",
      "key": "  ▪ ip      ",
      "keyColor": "38;2;119;119;119"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────┘",
      "outputColor": "38;2;51;51;51"
    },
    "break",
    {
      "type": "custom",
      "format": "❝ @QUOTE@ ❞",
      "outputColor": "38;2;242;242;242"
    }
  ]
}
